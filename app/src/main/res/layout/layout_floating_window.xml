<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_window_dark"
    android:clickable="true"
    android:fitsSystemWindows="false"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingTop="2dp"
    android:paddingEnd="7dp"
    android:paddingBottom="2dp">

    <!-- 实时功率容器 -->
    <LinearLayout
        android:id="@+id/layout_floating_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_floating_power_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:visibility="gone"
            android:contentDescription="@string/setting_floating_show_power"
            android:src="@drawable/ic_bolt"
            app:tint="#10B981" />

        <TextView
            android:id="@+id/tv_floating_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            tools:text="-3.2W" />
    </LinearLayout>

    <!-- 中间间隔符号 -->
    <TextView
        android:id="@+id/tv_floating_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="1dp"
        android:includeFontPadding="false"
        android:text="·"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 实时温度容器 -->
    <LinearLayout
        android:id="@+id/layout_floating_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_floating_temp_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:visibility="gone"
            android:contentDescription="@string/setting_floating_show_temp"
            android:src="@drawable/ic_thermometer"
            app:tint="#F59E0B" />

        <TextView
            android:id="@+id/tv_floating_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            tools:text="32.5℃" />
    </LinearLayout>

</LinearLayout>
