<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_sleep_awake_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="3">

    <!-- 卡片 1：息屏时间与能耗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_screen_off"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <!-- 第一行：百分比数值（靠左） + 息屏标签文字（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_screen_off_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="6.3%" />

                <TextView
                    android:id="@+id/tv_screen_off_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="@string/power_metric_screen_off"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：息屏时长（靠左）与消耗电量/能量（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_screen_off_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10.5sp"
                    tools:text="45m20s" />

                <TextView
                    android:id="@+id/tv_screen_off_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10.5sp"
                    tools:text="0.543Wh" />
            </LinearLayout>

            <!-- 第三行：息屏消耗能量/电荷量（靠左）与平均功耗（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_screen_off_compare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10.5sp"
                    tools:text="141.0 mAh" />

                <TextView
                    android:id="@+id/tv_screen_off_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10.5sp"
                    tools:text="0.25W" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 卡片 2：唤醒时间与能耗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_awake"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <!-- 第一行：百分比数值（靠左） + 唤醒标签文字（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_awake_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="2.2%" />

                <TextView
                    android:id="@+id/tv_awake_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="@string/power_metric_awake"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：唤醒时长（靠左）与消耗电量/能量（靠右，浅红高亮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_awake_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#FFA4A4"
                    android:textSize="10.5sp"
                    tools:text="4m10s" />

                <TextView
                    android:id="@+id/tv_awake_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#FFA4A4"
                    android:textSize="10.5sp"
                    tools:text="0.123Wh" />
            </LinearLayout>

            <!-- 第三行：唤醒消耗能量/电荷量（靠左）与平均功耗（靠右，浅红高亮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_awake_compare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#FFA4A4"
                    android:textSize="10.5sp"
                    tools:text="32.0 mAh" />

                <TextView
                    android:id="@+id/tv_awake_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#FFA4A4"
                    android:textSize="10.5sp"
                    tools:text="2.05W" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 卡片 3：深度睡眠时间与能耗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_deep_sleep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <!-- 第一行：百分比数值（靠左） + 深度睡眠标签文字（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sleep_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="4.1%" />

                <TextView
                    android:id="@+id/tv_sleep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="@string/power_metric_deep_sleep"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：深度睡眠时长（靠左）与消耗电量/能量（靠右，深红高亮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sleep_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#B71C1C"
                    android:textSize="10.5sp"
                    tools:text="41m10s" />

                <TextView
                    android:id="@+id/tv_sleep_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#B71C1C"
                    android:textSize="10.5sp"
                    tools:text="0.420Wh" />
            </LinearLayout>

            <!-- 第三行：深度睡眠消耗能量/电荷量（靠左）与平均功耗（靠右，深红高亮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sleep_compare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#B71C1C"
                    android:textSize="10.5sp"
                    tools:text="109.0 mAh" />

                <TextView
                    android:id="@+id/tv_sleep_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="#B71C1C"
                    android:textSize="10.5sp"
                    tools:text="0.07W" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
